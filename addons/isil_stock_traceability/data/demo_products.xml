<odoo>
  <!-- Demo Product A -->
  <record id="demo_product_a" model="product.product">
    <field name="name">Demo Product A</field>
    <field name="type">product</field>
    <field name="list_price">10.0</field>
    <field name="sale_ok">True</field>
    <field name="purchase_ok">True</field>
    <field name="sale_line_warn">no-message</field>
    <field name="purchase_line_warn">no-message</field>
    <field name="reorder_threshold">5.0</field>
    <field name="uom_id" ref="product.product_uom_unit"/>
    <field name="uom_po_id" ref="product.product_uom_unit"/>
    <field name="base_unit_count">1.0</field>
    <field name="categ_id" ref="product.product_category_all"/>
  </record>

  <!-- Demo Product B -->
  <record id="demo_product_b" model="product.product">
    <field name="name">Demo Product B</field>
    <field name="type">product</field>
    <field name="list_price">5.0</field>
    <field name="sale_ok">True</field>
    <field name="purchase_ok">True</field>
    <field name="reorder_threshold">2.0</field>
    <field name="uom_id" ref="product.product_uom_unit"/>
    <field name="uom_po_id" ref="product.product_uom_unit"/>
    <field name="base_unit_count">1.0</field>
    <field name="categ_id" ref="product.product_category_all"/>
  </record>
</odoo>
